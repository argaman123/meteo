{
  "name": "meteo",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"tools/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "basemap:fetch": "powershell -ExecutionPolicy Bypass -File tools/fetch-basemap.ps1",
    "serve:dist": "http-server dist/meteo/browser -p 8080 --silent"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@deck.gl/core": "^9.3.3",
    "@deck.gl/extensions": "^9.3.6",
    "@deck.gl/layers": "^9.3.3",
    "@deck.gl/mapbox": "^9.3.3",
    "@ng-icons/core": ">=32.0.0 <34.0.0",
    "@ng-icons/lucide": ">=32.0.0 <34.0.0",
    "@ng-icons/material-icons": "^33.4.0",
    "@spartan-ng/brain": "^1.0.4",
    "@turf/bbox-clip": "^7.3.5",
    "@turf/boolean-point-in-polygon": "^7.3.5",
    "@turf/buffer": "^7.3.5",
    "@turf/center-of-mass": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "d3-color": "^3.1.0",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "maplibre-gl": "^5.24.0",
    "pmtiles": "^4.4.1",
    "polylabel": "^2.1.0",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/heebo": "^5.2.8",
