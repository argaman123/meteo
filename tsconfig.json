{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@spartan-ng/helm/button": ["./src/spartan/button/src/index.ts"],
      "@spartan-ng/helm/utils": ["./src/spartan/utils/src/index.ts"],
      "@spartan-ng/helm/slider": ["./src/spartan/slider/src/index.ts"],
      "@spartan-ng/helm/checkbox": ["./src/spartan/checkbox/src/index.ts"],
      "@spartan-ng/helm/popover": ["./src/spartan/popover/src/index.ts"],
      "@spartan-ng/helm/dropdown-menu": ["./src/spartan/dropdown-menu/src/index.ts"],
      "@spartan-ng/helm/switch": ["./src/spartan/switch/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
